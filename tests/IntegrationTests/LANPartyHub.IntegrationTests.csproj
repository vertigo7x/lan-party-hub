<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LANPartyHub.IntegrationTests</RootNamespace>
    <AssemblyName>LANPartyHub.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- AD-16: the three test levels share the same runner stack, pinned to exact versions. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- AD-11: integration tests persist against a real SQLite file, never in memory. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\LANPartyHub.Shared.csproj" />
    <!-- AD-16: the integration level starts the real host of the server, with the real
         Kestrel and the real sockets, so it needs the composition root of the server. -->
    <ProjectReference Include="..\..\src\Server\LANPartyHub.Server.csproj" />
    <!-- AD-16: the integration level also starts the real client, with its real layout on
         disk and its real SQLite file, so it needs the composition root of the client. -->
    <ProjectReference Include="..\..\src\Client\LANPartyHub.Client.csproj" />
  </ItemGroup>

</Project>
