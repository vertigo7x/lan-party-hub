<?xml version="1.0" encoding="utf-8"?>
<!--
  AD-17: the artifact of the client is a self contained single file for Windows x64. It is the
  only profile of the artifact: the MVP declares support for no other platform (NFR-4).

  The project stays on net10.0 without a runtime identifier, so `dotnet build` and
  `dotnet test` do not depend on the RID and the runtime of the development machine is not
  forced.
-->
<Project>

  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
