<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LANPartyHub.Client</RootNamespace>
    <AssemblyName>LANPartyHub.Client</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\LANPartyHub.Shared.csproj" />
  </ItemGroup>

  <!--
    AD-28: the MVP project references no P2P library (no MonoTorrent, no tracker).
    AD-1: the client consumes the shared contracts and nothing else from the solution.
  -->

</Project>
