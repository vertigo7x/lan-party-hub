# ── BMAD: configuración personal (no se versiona) ─────────────────
# El resto de _bmad/, .agents/, .opencode/ y _bmad-output/ SÍ se versiona.
_bmad/**/*.user.toml
_bmad/**/*.user.yaml
_bmad/**/*.user.yml
_bmad/**/*.user.json
_bmad/output/
_bmad/render/*
!_bmad/render/.gitignore
_bmad/**/*.tmp
_bmad/**/*.log

# ── Bucle de construcción desatendido (logs locales) ─────────────
.build-loop/
.tmp-review/

